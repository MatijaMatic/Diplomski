@page "/detections"
@rendermode InteractiveServer
@inject NetworkAttackDetectionPlatform.Blazor.Services.IApiClient ApiClient
@inject IJSRuntime Js

<PageTitle>Attack Detections</PageTitle>

<div class="detections-container">
    <!-- Header -->
    <div class="detections-header">
        <div>
            <h1 class="detections-title">Attack Detections</h1>
            <p class="detections-subtitle">Monitor and manage detected network threats</p>
        </div>
        <button class="btn btn-primary" @onclick="LoadDetectionsAsync" disabled="@isLoading">
            <i class="bi bi-arrow-clockwise"></i> Refresh
        </button>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <strong>Error:</strong> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
        </div>
    }

    @if (isLoading)
    {
        <div class="loading-container">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3">Loading detections...</p>
        </div>
    }
    else
    {
        <!-- Statistics Header -->
        <div class="stats-grid">
            <StatisticCard 
                Value="@allDetections.Count.ToString()" 
                Label="Total Detections" 
                Icon="bi-shield-exclamation"
                IconClass="bg-primary" />

            <StatisticCard 
                Value="@allDetections.Count(d => d.Severity == 4).ToString()" 
                Label="Critical Detections" 
                Icon="bi-exclamation-triangle-fill"
                IconClass="bg-danger" />

            <StatisticCard 
                Value="@FormatConfidence(allDetections.Any() ? allDetections.Average(d => d.Confidence) : 0)" 
                Label="Avg Confidence" 
                Icon="bi-speedometer"
                IconClass="bg-info" />

            <StatisticCard 
                Value="@allDetections.Count(d => d.Status == 0).ToString()" 
                Label="New Detections" 
                Icon="bi-bell-fill"
                IconClass="bg-success" />
        </div>

        <!-- Filters Section -->
        <div class="filters-section">
            <h5 class="filters-title"><i class="bi bi-funnel"></i> Filters</h5>
            <div class="filters-grid">
                <div class="filter-item">
                    <label class="form-label">Attack Type</label>
                    <select @bind="filterAttackType" class="form-select">
                        <option value="-1">All Types</option>
                        <option value="0">Unknown</option>
                        <option value="1">Port Scan</option>
                        <option value="2">DDoS</option>
                        <option value="3">Malware</option>
                        <option value="4">Brute Force</option>
                        <option value="5">Phishing</option>
                        <option value="6">Data Exfiltration</option>
                    </select>
                </div>

                <div class="filter-item">
                    <label class="form-label">Severity</label>
                    <select @bind="filterSeverity" class="form-select">
                        <option value="-1">All Severities</option>
                        <option value="1">Low</option>
                        <option value="2">Medium</option>
                        <option value="3">High</option>
                        <option value="4">Critical</option>
                    </select>
                </div>

                <div class="filter-item">
                    <label class="form-label">Status</label>
                    <select @bind="filterStatus" class="form-select">
                        <option value="-1">All Statuses</option>
                        <option value="0">New</option>
                        <option value="1">Analyzed</option>
                        <option value="2">Confirmed</option>
                        <option value="3">False Positive</option>
                        <option value="4">Resolved</option>
                    </select>
                </div>

                <div class="filter-item">
                    <label class="form-label">Minimum Confidence (%)</label>
                    <input type="number" @bind="minConfidence" class="form-control" min="0" max="100" step="1" placeholder="0" />
                </div>

                <div class="filter-item">
                    <label class="form-label">Date From</label>
                    <input type="date" @bind="filterDateFrom" class="form-control" />
                </div>

                <div class="filter-item">
                    <label class="form-label">Date To</label>
                    <input type="date" @bind="filterDateTo" class="form-control" />
                </div>
            </div>

            <div class="filters-actions">
                <button class="btn btn-secondary" @onclick="ClearFilters">
                    <i class="bi bi-x-circle"></i> Clear Filters
                </button>
            </div>
        </div>

        <!-- Detections Table -->
        <div class="table-section">
            <div class="table-header">
                <h5 class="table-title">
                    <i class="bi bi-table"></i> Detections List
                </h5>
                <span class="table-count">Showing @FilteredDetections.Count() of @allDetections.Count detections</span>
            </div>

            @if (!FilteredDetections.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-inbox"></i>
                    <h4>No Detections Found</h4>
                    <p>Try adjusting your filters or refresh the data.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Source</th>
                                <th>Destination</th>
                                <th>Attack Type</th>
                                <th>Severity</th>
                                <th>Confidence</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in FilteredDetections)
                            {
                                <tr>
                                    <td>
                                        <div class="ip-info">
                                            <strong>@d.SourceIp</strong>
                                            <small class="text-muted">:@d.SourcePort</small>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="ip-info">
                                            <strong>@d.DestinationIp</strong>
                                            <small class="text-muted">:@d.DestinationPort</small>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@MapAttackType(d.AttackType)</span>
                                    </td>
                                    <td>
                                        <span class="badge @GetSeverityBadgeClass(d.Severity)">
                                            @MapSeverity(d.Severity)
                                        </span>
                                    </td>
                                    <td>
                                        <div class="confidence-display">
                                            <span class="confidence-value">@(d.Confidence.ToString("F1"))%</span>
                                            <div class="confidence-bar">
                                                <div class="confidence-fill" style="width: @(d.Confidence.ToString("F1"))%"></div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge @GetStatusBadgeClass(d.Status)">
                                            @MapStatus(d.Status)
                                        </span>
                                    </td>
                                    <td>
                                        <small>@d.CreatedAt.ToLocalTime().ToString("g")</small>
                                    </td>
                                    <td>
                                        <div class="action-buttons">
                                            <button class="btn btn-sm btn-info" @onclick="() => ViewDetails(d.Id)" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            <button class="btn btn-sm btn-warning" @onclick="() => ShowStatusModal(d.Id, d.Status)" title="Update Status">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn btn-sm btn-danger" @onclick="() => ConfirmDelete(d.Id)" title="Delete" disabled="@IsProcessing(d.Id)">
                                                @if (IsProcessing(d.Id))
                                                {
                                                    <span class="spinner-border spinner-border-sm"></span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-trash"></i>
                                                }
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

<!-- View Details Modal -->
@if (showDetailsModal && selectedDetection != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-shield-exclamation"></i> Detection Details
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseDetailsModal"></button>
                </div>
                <div class="modal-body">
                    @if (isLoadingDetails)
                    {
                        <div class="text-center p-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="details-grid">
                            <div class="detail-item">
                                <label>Detection ID</label>
                                <span>@selectedDetection.Id</span>
                            </div>
                            <div class="detail-item">
                                <label>Source IP</label>
                                <span>@selectedDetection.SourceIp:@selectedDetection.SourcePort</span>
                            </div>
                            <div class="detail-item">
                                <label>Destination IP</label>
                                <span>@selectedDetection.DestinationIp:@selectedDetection.DestinationPort</span>
                            </div>
                            <div class="detail-item">
                                <label>Protocol</label>
                                <span>@MapProtocol(selectedDetection.Protocol)</span>
                            </div>
                            <div class="detail-item">
                                <label>Attack Type</label>
                                <span class="badge bg-secondary">@MapAttackType(selectedDetection.AttackType)</span>
                            </div>
                            <div class="detail-item">
                                <label>Severity</label>
                                <span class="badge @GetSeverityBadgeClass(selectedDetection.Severity)">
                                    @MapSeverity(selectedDetection.Severity)
                                </span>
                            </div>
                            <div class="detail-item">
                                <label>Confidence</label>
                                <span>@(selectedDetection.Confidence.ToString("F2"))%</span>
                            </div>
                            <div class="detail-item">
                                <label>Status</label>
                                <span class="badge @GetStatusBadgeClass(selectedDetection.Status)">
                                    @MapStatus(selectedDetection.Status)
                                </span>
                            </div>
                            <div class="detail-item">
                                <label>Occurrence Start</label>
                                <span>@selectedDetection.OccurrenceStart.ToLocalTime().ToString("g")</span>
                            </div>
                            <div class="detail-item">
                                <label>Occurrence End</label>
                                <span>@selectedDetection.OccurrenceEnd.ToLocalTime().ToString("g")</span>
                            </div>
                            <div class="detail-item">
                                <label>Created At</label>
                                <span>@selectedDetection.CreatedAt.ToLocalTime().ToString("g")</span>
                            </div>
                            <div class="detail-item">
                                <label>Updated At</label>
                                <span>@selectedDetection.UpdatedAt.ToLocalTime().ToString("g")</span>
                            </div>
                        </div>

                        @if (selectedDetection.Recommendations != null && selectedDetection.Recommendations.Any())
                        {
                            <div class="recommendations-section mt-4">
                                <h6><i class="bi bi-lightbulb"></i> Recommendations</h6>
                                <ul class="list-group">
                                    @foreach (var rec in selectedDetection.Recommendations)
                                    {
                                        <li class="list-group-item">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div>
                                                    <p class="mb-1">@rec.Text</p>
                                                    <small class="text-muted">
                                                        Created: @rec.CreatedAt.ToLocalTime().ToString("g")
                                                    </small>
                                                </div>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info mt-4">
                                <i class="bi bi-info-circle"></i> No recommendations available for this detection.
                            </div>
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDetailsModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Status Update Modal -->
@if (showStatusModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-pencil"></i> Update Status
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseStatusModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Select New Status</label>
                        <select @bind="newStatus" class="form-select">
                            <option value="New">New</option>
                            <option value="Analyzed">Analyzed</option>
                            <option value="Confirmed">Confirmed</option>
                            <option value="FalsePositive">False Positive</option>
                            <option value="Resolved">Resolved</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseStatusModal">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="UpdateStatus" disabled="@isUpdatingStatus">
                        @if (isUpdatingStatus)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Update Status
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private bool isLoadingDetails = false;
    private bool isUpdatingStatus = false;
    private List<NetworkAttackDetectionPlatform.Blazor.Services.Dtos.AttackDetectionDto> allDetections = new();
    private int totalCount = 0;

    // Filters
    private int filterAttackType = -1;
    private int filterSeverity = -1;
    private int filterStatus = -1;
    private int? minConfidence;
    private DateTime? filterDateFrom;
    private DateTime? filterDateTo;

    // Modals
    private bool showDetailsModal = false;
    private bool showStatusModal = false;
    private NetworkAttackDetectionPlatform.Blazor.Services.Dtos.AttackDetectionDto? selectedDetection;
    private Guid statusUpdateId;
    private string newStatus = "New";

    private HashSet<Guid> processing = new();
    private string errorMessage = string.Empty;

    private IEnumerable<NetworkAttackDetectionPlatform.Blazor.Services.Dtos.AttackDetectionDto> FilteredDetections
    {
        get
        {
            var filtered = allDetections.AsEnumerable();

            if (filterAttackType != -1)
                filtered = filtered.Where(d => d.AttackType == filterAttackType);

            if (filterSeverity != -1)
                filtered = filtered.Where(d => d.Severity == filterSeverity);

            if (filterStatus != -1)
                filtered = filtered.Where(d => d.Status == filterStatus);

            if (minConfidence.HasValue)
                filtered = filtered.Where(d => d.Confidence >= minConfidence.Value);

            if (filterDateFrom.HasValue)
                filtered = filtered.Where(d => d.OccurrenceStart.Date >= filterDateFrom.Value.Date);

            if (filterDateTo.HasValue)
                filtered = filtered.Where(d => d.OccurrenceStart.Date <= filterDateTo.Value.Date);

            return filtered.OrderByDescending(d => d.CreatedAt);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDetectionsAsync();
    }

    private async Task LoadDetectionsAsync()
    {
        isLoading = true;
        errorMessage = string.Empty;
        try
        {
            var pagedResult = await ApiClient.GetAllDetectionsAsync();
            allDetections = pagedResult.Items;
            totalCount = pagedResult.TotalCount;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load detections: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ClearFilters()
    {
        filterAttackType = -1;
        filterSeverity = -1;
        filterStatus = -1;
        minConfidence = null;
        filterDateFrom = null;
        filterDateTo = null;
    }

    private bool IsProcessing(Guid id) => processing.Contains(id);

    private async Task ViewDetails(Guid id)
    {
        showDetailsModal = true;
        isLoadingDetails = true;
        selectedDetection = null;
        StateHasChanged();

        try
        {
            selectedDetection = await ApiClient.GetDetectionByIdAsync(id);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load detection details: {ex.Message}";
            showDetailsModal = false;
        }
        finally
        {
            isLoadingDetails = false;
            StateHasChanged();
        }
    }

    private void CloseDetailsModal()
    {
        showDetailsModal = false;
        selectedDetection = null;
    }

    private void ShowStatusModal(Guid id, int currentStatus)
    {
        statusUpdateId = id;
        newStatus = MapStatus(currentStatus);
        showStatusModal = true;
    }

    private void CloseStatusModal()
    {
        showStatusModal = false;
        statusUpdateId = Guid.Empty;
    }

    private async Task UpdateStatus()
    {
        isUpdatingStatus = true;
        errorMessage = string.Empty;

        try
        {
            var success = await ApiClient.UpdateDetectionStatusAsync(statusUpdateId, newStatus);
            if (success)
            {
                CloseStatusModal();
                await LoadDetectionsAsync();
            }
            else
            {
                errorMessage = "Failed to update status. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to update status: {ex.Message}";
        }
        finally
        {
            isUpdatingStatus = false;
        }
    }

    private async Task ConfirmDelete(Guid id)
    {
        var confirmed = await Js.InvokeAsync<bool>("confirm", "Are you sure you want to delete this detection? This action cannot be undone.");
        if (!confirmed) return;

        processing.Add(id);
        errorMessage = string.Empty;
        StateHasChanged();

        try
        {
            var success = await ApiClient.DeleteDetectionAsync(id);
            if (success)
            {
                await LoadDetectionsAsync();
            }
            else
            {
                errorMessage = "Failed to delete detection. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete detection: {ex.Message}";
        }
        finally
        {
            processing.Remove(id);
            StateHasChanged();
        }
    }

    private string FormatConfidence(double confidence)
    {
        return $"{confidence:F1}%";
    }

    private string MapAttackType(int t) => t switch
    {
        0 => "Unknown",
        1 => "Port Scan",
        2 => "DDoS",
        3 => "Malware",
        4 => "Brute Force",
        5 => "Phishing",
        6 => "Data Exfiltration",
        _ => "Unknown"
    };

    private string MapSeverity(int s) => s switch
    {
        0 => "Unknown",
        1 => "Low",
        2 => "Medium",
        3 => "High",
        4 => "Critical",
        _ => "Unknown"
    };

    private string MapStatus(int s) => s switch
    {
        0 => "New",
        1 => "Analyzed",
        2 => "Confirmed",
        3 => "FalsePositive",
        4 => "Resolved",
        _ => "Unknown"
    };

    private string MapProtocol(int p) => p switch
    {
        0 => "Unknown",
        1 => "TCP",
        2 => "UDP",
        3 => "ICMP",
        4 => "Other",
        _ => "Unknown"
    };

    private string GetSeverityBadgeClass(int severity) => severity switch
    {
        4 => "bg-danger",
        3 => "bg-warning text-dark",
        2 => "bg-info text-dark",
        1 => "bg-success",
        _ => "bg-secondary"
    };

    private string GetStatusBadgeClass(int status) => status switch
    {
        0 => "bg-primary",
        1 => "bg-info",
        2 => "bg-danger",
        3 => "bg-warning text-dark",
        4 => "bg-success",
        _ => "bg-secondary"
    };
}
