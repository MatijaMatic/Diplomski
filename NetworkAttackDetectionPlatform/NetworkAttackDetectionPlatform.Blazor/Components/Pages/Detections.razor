@page "/detections"
@inject NetworkAttackDetectionPlatform.Blazor.Services.IApiClient ApiClient
@inject IJSRuntime Js

<h3>Detections</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (isLoading)
{
    <p>Loading...</p>
}
else
{
    <div class="mb-3">
        <label>Attack Type:</label>
        <select @bind="filterAttackType" class="form-select">
            <option value="-1">All</option>
            <option value="1">PortScan</option>
            <option value="2">DDoS</option>
            <option value="3">Malware</option>
            <option value="4">BruteForce</option>
            <option value="5">Phishing</option>
            <option value="6">DataExfiltration</option>
        </select>
    </div>
    <div class="mb-3">
        <label>Severity:</label>
        <select @bind="filterSeverity" class="form-select">
            <option value="-1">All</option>
            <option value="1">Low</option>
            <option value="2">Medium</option>
            <option value="3">High</option>
            <option value="4">Critical</option>
        </select>
    </div>
    <div class="mb-3">
        <label>Date (from):</label>
        <input type="date" @bind="filterDate" class="form-control" />
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Source</th>
                <th>Destination</th>
                <th>Attack Type</th>
                <th>Severity</th>
                <th>Confidence</th>
                <th>Status</th>
                <th>Created</th>
                <th>Updated</th>
                <th>Time</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in FilteredDetections)
            {
                <tr>
                    <td>@d.SourceIp:@d.SourcePort</td>
                    <td>@d.DestinationIp:@d.DestinationPort</td>
                    <td>@MapAttackType(d.AttackType)</td>
                    <td>@MapSeverity(d.Severity)</td>
                    <td>@d.Confidence</td>
                    <td>@MapStatus(d.Status)</td>
                    <td>@d.CreatedAt.ToLocalTime().ToString("g")</td>
                    <td>@d.UpdatedAt.ToLocalTime().ToString("g")</td>
                    <td>@d.OccurrenceEnd.ToLocalTime().ToString("g")</td>
                    <td>
                        @if (IsProcessing(d.Id))
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span class="ms-1">Processing...</span>
                        }
                        else
                        {
                            @if (d.Status == 0) // New
                            {
                                <button class="btn btn-sm btn-primary me-1" @onclick="() => MarkAnalyzed(d.Id)" disabled="@IsProcessing(d.Id)">Mark Analyzed</button>
                            }
                            else if (d.Status == 1) // Analyzed
                            {
                                <button class="btn btn-sm btn-success me-1" @onclick="() => ConfirmAttack(d.Id)" disabled="@IsProcessing(d.Id)">Confirm Attack</button>
                                <button class="btn btn-sm btn-warning me-1" @onclick="() => MarkFalsePositive(d.Id)" disabled="@IsProcessing(d.Id)">Mark False Positive</button>
                            }
                            else if (d.Status == 2) // Confirmed
                            {
                                <button class="btn btn-sm btn-secondary me-1" @onclick="() => Resolve(d.Id)" disabled="@IsProcessing(d.Id)">Resolve</button>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private bool isLoading = true;
    private List<NetworkAttackDetectionPlatform.Blazor.Services.Dtos.AttackDetectionDto> allDetections = new();

    private int filterAttackType = -1;
    private int filterSeverity = -1;
    private DateTime? filterDate;

    private HashSet<Guid> processing = new();
    private string errorMessage = string.Empty;

    private IEnumerable<NetworkAttackDetectionPlatform.Blazor.Services.Dtos.AttackDetectionDto> FilteredDetections =>
        allDetections.Where(d => (filterAttackType == -1 || d.AttackType == filterAttackType)
                                && (filterSeverity == -1 || d.Severity == filterSeverity)
                                && (!filterDate.HasValue || d.OccurrenceStart.Date >= filterDate.Value.Date));

    protected override async Task OnInitializedAsync()
    {
        await LoadDetectionsAsync();
    }

    private async Task LoadDetectionsAsync()
    {
        isLoading = true;
        errorMessage = string.Empty;
        try
        {
            allDetections = await ApiClient.GetAllDetectionsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load detections: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private bool IsProcessing(Guid id) => processing.Contains(id);

    private async Task OnChangeStatus(Guid id, string newStatus)
    {
        errorMessage = string.Empty;
        // confirm
        var confirmed = await Js.InvokeAsync<bool>("confirm", $"Are you sure you want to set status to '{newStatus}'?");
        if (!confirmed) return;

        processing.Add(id);
        StateHasChanged();
        try
        {
            var ok = await ApiClient.UpdateDetectionStatusAsync(id, newStatus);
            if (!ok)
            {
                errorMessage = "API returned an error while updating status.";
            }
            else
            {
                // refresh list
                await LoadDetectionsAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to update status: " + ex.Message;
        }
        finally
        {
            processing.Remove(id);
            StateHasChanged();
        }
    }

    private Task MarkAnalyzed(Guid id) => OnChangeStatus(id, "Analyzed");
    private Task ConfirmAttack(Guid id) => OnChangeStatus(id, "Confirmed");
    private Task MarkFalsePositive(Guid id) => OnChangeStatus(id, "FalsePositive");
    private Task Resolve(Guid id) => OnChangeStatus(id, "Resolved");

    private string MapAttackType(int t) => t switch
    {
        1 => "PortScan",
        2 => "DDoS",
        3 => "Malware",
        4 => "BruteForce",
        5 => "Phishing",
        6 => "DataExfiltration",
        _ => "Unknown"
    };

    private string MapSeverity(int s) => s switch
    {
        1 => "Low",
        2 => "Medium",
        3 => "High",
        4 => "Critical",
        _ => "Unknown"
    };

    private string MapStatus(int s) => s switch
    {
        0 => "New",
        1 => "Analyzed",
        2 => "Confirmed",
        3 => "FalsePositive",
        4 => "Resolved",
        _ => "Unknown"
    };
}
