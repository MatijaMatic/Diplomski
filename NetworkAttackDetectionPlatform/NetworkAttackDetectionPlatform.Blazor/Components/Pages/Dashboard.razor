@page "/dashboard"
@rendermode InteractiveServer
@using NetworkAttackDetectionPlatform.Blazor.Services
@using NetworkAttackDetectionPlatform.Blazor.Services.Dtos
@inject IDashboardApiService DashboardApi

<PageTitle>Dashboard - AI Network Attack Detection</PageTitle>

<div class="dashboard-container">
    <!-- Header -->
    <div class="dashboard-header">
        <div>
            <h1 class="dashboard-title">AI Network Attack Detection Dashboard</h1>
            <p class="dashboard-subtitle">Machine Learning based network threat monitoring</p>
        </div>
        <button class="btn btn-primary" @onclick="RefreshData" disabled="@isLoading">
            <i class="bi bi-arrow-clockwise"></i> Refresh
        </button>
    </div>

    @if (isLoading)
    {
        <div class="loading-container">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3">Loading dashboard...</p>
        </div>
    }
    else if (hasError)
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <strong>Unable to load dashboard data.</strong> Please ensure the API is running on http://localhost:5067
        </div>
    }
    else
    {
        <!-- Statistics Cards -->
        <div class="stats-grid">
            <StatisticCard 
                Value="@(statistics?.TotalAttacks.ToString() ?? "0")" 
                Label="Total Attacks" 
                Icon="bi-shield-exclamation"
                IconClass="bg-primary" />

            <StatisticCard 
                Value="@(statistics?.AttacksToday.ToString() ?? "0")" 
                Label="Attacks Today" 
                Icon="bi-calendar-event"
                IconClass="bg-success" />

            <StatisticCard 
                Value="@(statistics?.CriticalAttacks.ToString() ?? "0")" 
                Label="Critical Attacks" 
                Icon="bi-exclamation-triangle-fill"
                IconClass="bg-danger" />

            <StatisticCard 
                Value="@(FormatConfidence(statistics?.AverageConfidence))" 
                Label="Avg Confidence" 
                Icon="bi-speedometer"
                IconClass="bg-info" />
        </div>

        <!-- Charts Row -->
        <div class="charts-row">
            <div class="chart-col">
                <AttackTimelineChart Data="@timeline" Days="7" />
            </div>
            <div class="chart-col">
                <SeverityChart Data="@severityDist" />
            </div>
        </div>

        <!-- Attack Distribution -->
        <div class="chart-full">
            <AttackDistributionChart Data="@attackDist" />
        </div>

        <!-- Recent Attacks Table -->
        <div class="table-section">
            <h4 class="section-title">
                <i class="bi bi-clock-history"></i> Recent Attacks
            </h4>
            <RecentAttacksTable Attacks="@recentAttacks" />
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private bool hasError = false;

    private DashboardStatisticsDto? statistics;
    private List<RecentAttackDto> recentAttacks = new();
    private List<AttackTimelineDto> timeline = new();
    private List<AttackDistributionDto> attackDist = new();
    private SeverityDistributionDto? severityDist;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
    }

    private async Task RefreshData()
    {
        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        isLoading = true;
        hasError = false;
        StateHasChanged();

        try
        {
            statistics = await DashboardApi.GetStatisticsAsync();
            recentAttacks = await DashboardApi.GetRecentAttacksAsync(10);
            timeline = await DashboardApi.GetTimelineAsync(7);
            attackDist = await DashboardApi.GetAttackDistributionAsync();
            severityDist = await DashboardApi.GetSeverityDistributionAsync();

            if (statistics == null)
            {
                hasError = true;
            }
        }
        catch (Exception)
        {
            hasError = true;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private string FormatConfidence(double? confidence)
    {
        return confidence.HasValue ? $"{confidence.Value:F1}%" : "0%";
    }
}
