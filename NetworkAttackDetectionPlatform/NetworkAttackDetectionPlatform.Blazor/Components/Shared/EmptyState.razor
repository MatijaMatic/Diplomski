<div class="empty-state">
    <i class="bi @Icon"></i>
    <h4>@Title</h4>
    <p>@Message</p>
    @if (ShowAction && !string.IsNullOrWhiteSpace(ActionText))
    {
        <button class="btn btn-primary mt-3" @onclick="OnActionClick">
            <i class="bi @ActionIcon"></i> @ActionText
        </button>
    }
</div>

@code {
    [Parameter]
    public string Icon { get; set; } = "bi-inbox";

    [Parameter]
    public string Title { get; set; } = "No Data Found";

    [Parameter]
    public string Message { get; set; } = "There is no data to display.";

    [Parameter]
    public bool ShowAction { get; set; } = false;

    [Parameter]
    public string ActionText { get; set; } = "";

    [Parameter]
    public string ActionIcon { get; set; } = "bi-plus-circle";

    [Parameter]
    public EventCallback OnActionClick { get; set; }
}
